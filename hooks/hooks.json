{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/lint-edited-file.sh\"",
            "statusMessage": "Checking syntax...",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
